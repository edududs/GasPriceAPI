# Variáveis de ambiente. O docker compose lê este arquivo como .env; fora dele, exporte no shell.
# Só DJANGO_SECRET_KEY é obrigatória com o modo debug desligado.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://gasprice.example.com
# DJANGO_SECURE_SSL_REDIRECT=1

# Sem DATABASE_URL, usa SQLite em ./data/gasprice.sqlite3
# DATABASE_URL=postgres://gasprice:gasprice@localhost:5432/gasprice

# Página do levantamento semanal da ANP, de onde a planilha mais recente é descoberta
# GASPRICE_ANP_PAGE_URL=https://www.gov.br/anp/pt-br/assuntos/precos-e-defesa-da-concorrencia/precos/levantamento-do-precos-de-combustiveis-ultimas-semanas-pesquisadas
# GASPRICE_HTTP_TIMEOUT=30
# Idade máxima, em dias, da última coleta real antes de /api/v1/health responder 503
# GASPRICE_MAX_AGE_DAYS=15
# LOG_LEVEL=INFO
